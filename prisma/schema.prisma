  created_time        DateTime       @default(now()) @db.Timestamp(0)
  updated_by          String?        @db.VarChar(30)
  updated_time        DateTime?      @db.Timestamp(0)
  tax_catalog         String?        @db.VarChar(100)
  tax_percentage      Decimal?       @db.Decimal(5, 2)
  prescription        prescription[]
  appointment         appointment    @relation(fields: [appointment_id], references: [appointment_id], map: "fk_treatment_appointment")
  clinic              clinic         @relation(fields: [clinic_id], references: [clinic_id], map: "fk_treatment_clinic")
  dentist             dentist        @relation(fields: [dentist_id], references: [dentist_id], map: "fk_treatment_dentist")
  patient             patient        @relation(fields: [patient_id], references: [patient_id], map: "fk_treatment_patient")
  tenant              tenant         @relation(fields: [tenant_id], references: [tenant_id], map: "fk_treatment_tenant")

  @@index([appointment_id], map: "fk_treatment_appointment")
  @@index([clinic_id], map: "fk_treatment_clinic")
  @@index([dentist_id], map: "fk_treatment_dentist")
  @@index([patient_id], map: "fk_treatment_patient")
  @@index([tenant_id], map: "fk_treatment_tenant")
}

model user_activity {
  user_activity_id BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id        BigInt?   @db.UnsignedBigInt
  app_name         String?   @db.VarChar(100)
  keycloak_user_id String    @db.Char(36)
  activity_type    String    @db.VarChar(100)
  activity_desc    String?   @db.Text
  ip_address       String?   @db.VarChar(45)
  user_agent       String?   @db.Text
  activity_time    DateTime? @default(now()) @db.Timestamp(0)

  @@index([tenant_id], map: "idx_user_activity_tenant")
  @@index([keycloak_user_id], map: "idx_user_activity_user")
}

model user_clinic {
  user_clinic_id BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt    @db.UnsignedBigInt
  user_name      String    @db.VarChar(100)
  role           String    @db.VarChar(50)
  keycloak_id    String?   @db.Char(36)
  tenant_id      BigInt?   @db.UnsignedBigInt
  clinic_id      BigInt    @db.UnsignedBigInt
  created_by     String    @db.VarChar(30)
  created_time   DateTime  @default(now()) @db.Timestamp(0)
  updated_by     String?   @db.VarChar(30)
  updated_time   DateTime? @db.Timestamp(0)
  clinic         clinic    @relation(fields: [clinic_id], references: [clinic_id], onDelete: Cascade, map: "fk_user_clinic_clinic")
  tenant         tenant?   @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, map: "fk_user_clinic_tenant")

  @@index([clinic_id], map: "fk_user_clinic_clinic")
  @@index([tenant_id], map: "fk_user_clinic_tenant")
  @@index([keycloak_id], map: "idx_user_clinic_keycloak")
}

