generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model appointment {
  appointment_id           BigInt                                @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id                BigInt                                @db.UnsignedBigInt
  patient_id               BigInt                                @db.UnsignedBigInt
  dentist_id               BigInt                                @db.UnsignedBigInt
  clinic_id                BigInt                                @db.UnsignedBigInt
  room_id                  String?                               @default("00000000-0000-0000-0000-000000000000") @db.Char(36)
  appointment_date         DateTime                              @db.Date
  start_time               DateTime                              @db.Time(0)
  end_time                 DateTime                              @db.Time(0)
  status                   appointment_status                    @default(pending)
  appointment_final_status appointment_appointment_final_status? @default(pending)
  appointment_type         appointment_appointment_type?
  doctor_rating            Decimal?                              @db.Decimal(3, 2)
  feedback                 String?                               @db.Text
  consultation_fee         Decimal?                              @default(0.00) @db.Decimal(12, 2)
  discount_applied         Decimal?                              @default(0.00) @db.Decimal(12, 2)
  payment_status           String?                               @db.VarChar(100)
  min_booking_fee          Decimal?                              @default(0.00) @db.Decimal(12, 2)
  paid_amount              Decimal?                              @default(0.00) @db.Decimal(12, 2)
  rescheduled_from         BigInt?                               @db.UnsignedBigInt
  cancelled_by             String?                               @db.VarChar(30)
  cancellation_reason      String?                               @db.Text
  is_virtual               Boolean?                              @default(false)
  reminder_send            Boolean?                              @default(false)
  feedback_display         Boolean?                              @default(true)
  meeting_link             String?                               @db.VarChar(255)
  checkin_time             DateTime?                             @db.DateTime(0)
  checkout_time            DateTime?                             @db.DateTime(0)
  mode_of_payment          String                                @db.VarChar(100)
  visit_reason             String?                               @db.Text
  follow_up_needed         Boolean                               @default(false)
  reminder_method          String?                               @db.VarChar(100)
  notes                    String?                               @db.Text
  created_by               String                                @db.VarChar(30)
  created_time             DateTime                              @default(now()) @db.Timestamp(0)
  updated_by               String?                               @db.VarChar(30)
  updated_time             DateTime?                             @db.Timestamp(0)
  clinic                   clinic                                @relation(fields: [clinic_id], references: [clinic_id], map: "fk_appointment_clinic")
  dentist                  dentist                               @relation(fields: [dentist_id], references: [dentist_id], map: "fk_appointment_dentist")
  patient                  patient                               @relation(fields: [patient_id], references: [patient_id], map: "fk_appointment_patient")
  tenant                   tenant                                @relation(fields: [tenant_id], references: [tenant_id], map: "fk_appointment_tenant")
  payment                  payment[]
  treatment                treatment[]

  @@index([clinic_id], map: "fk_appointment_clinic")
  @@index([dentist_id], map: "fk_appointment_dentist")
  @@index([patient_id], map: "fk_appointment_patient")
  @@index([tenant_id], map: "fk_appointment_tenant")
  @@index([tenant_id, appointment_date, start_time, status], map: "idx_tenant_date_time_status")
}

model appointment_reschedules {
  rescheduled_id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id               BigInt    @db.UnsignedBigInt
  clinic_id               BigInt    @db.UnsignedBigInt
  dentist_id              BigInt    @db.UnsignedBigInt
  original_appointment_id BigInt    @db.UnsignedBigInt
  new_appointment_id      BigInt    @db.UnsignedBigInt
  previous_date           DateTime  @db.Date
  previous_time           DateTime  @db.Time(0)
  new_date                DateTime  @db.Date
  new_start_time          DateTime  @db.Time(0)
  new_end_time            DateTime  @db.Time(0)
  reason                  String    @db.Text
  charge_applicable       Boolean   @default(false)
  charge_amount           Decimal   @default(0.00) @db.Decimal(12, 2)
  rescheduled_by          String    @db.VarChar(30)
  rescheduled_at          DateTime? @db.Timestamp(0)
  created_by              String    @db.VarChar(30)
  created_time            DateTime  @default(now()) @db.Timestamp(0)
  updated_by              String?   @db.VarChar(30)
  updated_time            DateTime? @db.Timestamp(0)
  clinic                  clinic    @relation(fields: [clinic_id], references: [clinic_id], map: "fk_appointment_reschedules_clinic")
  dentist                 dentist   @relation(fields: [dentist_id], references: [dentist_id], map: "fk_appointment_reschedules_dentist")
  tenant                  tenant    @relation(fields: [tenant_id], references: [tenant_id], map: "fk_appointment_reschedules_tenant")

  @@index([clinic_id], map: "fk_appointment_reschedules_clinic")
  @@index([dentist_id], map: "fk_appointment_reschedules_dentist")
  @@index([tenant_id], map: "fk_appointment_reschedules_tenant")
}

model appointment_stats {
  appointment_stats_id BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tenant_id            BigInt    @db.UnsignedBigInt
  clinic_id            BigInt    @db.UnsignedBigInt
  dentist_id           BigInt?   @db.UnsignedBigInt
  stat_date            DateTime  @db.Date
  confirmed            Int?      @default(0)
  completed            Int?      @default(0)
  cancelled            Int?      @default(0)
  created_by           String    @default("ADMIN") @db.VarChar(30)
  created_time         DateTime  @default(now()) @db.Timestamp(0)
  updated_by           String?   @db.VarChar(30)
  updated_time         DateTime? @db.Timestamp(0)

  @@unique([tenant_id, clinic_id, dentist_id, stat_date], map: "uk_tenant_date")
}

